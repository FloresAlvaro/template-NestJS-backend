# Nombre DNS sin https:// ni barra final. DNS local -> IP fija del servidor.
TIENDA_HOST=tienda.home.arpa
# IP LAN del servidor. 127.0.0.1 solo permite pruebas desde el propio host.
BIND_IP=127.0.0.1
# Usa openssl rand -hex 32: evita caracteres especiales en la URL PostgreSQL.
POSTGRES_PASSWORD=REEMPLAZAR_CON_64_CARACTERES_HEXADECIMALES
APP_TAG=local
ORDER_RESERVATION_MINUTES=1440
ORDER_NOTIFICATIONS_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=REEMPLAZAR
SMTP_PASSWORD='REEMPLAZAR'
MAIL_FROM=tienda@example.com
