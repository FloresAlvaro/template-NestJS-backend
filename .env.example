DATABASE_URL=postgresql://tienda:tienda@localhost:5432/tienda?schema=public
# Solo para db:seed: correo de un administrador activo ya creado.
SEED_ADMIN_EMAIL=
PORT=3001
# Reserva de pedidos pendientes: 1 a 10080 minutos; por defecto 24 horas.
ORDER_RESERVATION_MINUTES=1440
COOKIE_SECURE=false
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

# Correo local capturado por Mailpit (no entrega mensajes a Internet).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@tienda.local
PASSWORD_RESET_URL=http://localhost:3001/api/auth/reset-password
